# ---------------------------------------------------------------------------------------------------------------------
# Daily Stock Analysis for India (NSE/BSE). Copy to .env and fill what you use. Everything is optional except STOCK_LIST.
# ---------------------------------------------------------------------------------------------------------------------

# Watchlist: NSE symbols (RELIANCE, NSE:TCS, INFY.NS), BSE scrip codes (500325, BSE:500325, RELIANCE.BO),
# ETFs (NIFTYBEES) or indices (NIFTY50, SENSEX, BANKNIFTY)
STOCK_LIST=RELIANCE,TCS,HDFCBANK,INFY

# ---- AI model (configure at least one for AI analysis; without one the report is technical-only) -----------------------
LLM_PROVIDER_ORDER=anthropic,gemini,openai
# Claude via the official Anthropic SDK (or run `ant auth login`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Any OpenAI-compatible endpoint: OpenAI, DeepSeek (https://api.deepseek.com/v1), OpenRouter, Groq, local Ollama
# (http://localhost:11434/v1, no key needed). OPENAI_MODEL is required when this provider is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=300

# ---- News search (Google News India RSS works with no key; keyed providers are tried first) ---------------------------
GOOGLE_NEWS_RSS_ENABLED=true
TAVILY_API_KEYS=
SERPAPI_API_KEYS=
BRAVE_API_KEYS=
NEWS_MAX_AGE_DAYS=7

# ---- Data sources -------------------------------------------------------------------------------------------------------
# yfinance first (fast history), NSE bhavcopy as fallback; set "nse,yfinance" to prefer the exchange's own files
DATA_SOURCE_PRIORITY=yfinance,nse
NSE_ENABLED=true
ENABLE_DELIVERY=true
HISTORY_DAYS=120

# ---- Email (optional; results are read on the web page, messaging apps are not supported) ------------------------------
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVERS=
EMAIL_SENDER_NAME=India Stock Analysis
# SMTP is detected from the sender domain (gmail, outlook, yahoo, zoho, rediffmail, icloud); override if needed
SMTP_SERVER=
SMTP_PORT=

# ---- Run behaviour ------------------------------------------------------------------------------------------------------
# Trading style: short = days to 2 weeks (the original project's MA5/MA10 style); swing = 2-8 weeks (trend template,
# relative strength vs NIFTY, pullback/breakout setups, ATR stops capped at 8%, 2R/3R targets, position sizing)
TRADING_STYLE=short
# Swing position sizing: capital in ₹ and % of capital lost if a stop is hit
CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
# simple = summary + core conclusion + battle plan per stock; full = the complete dashboard
REPORT_TYPE=simple
REPORT_LANGUAGE=en
MARKET_REVIEW_ENABLED=true
SINGLE_STOCK_NOTIFY=false
TRADING_DAY_CHECK_ENABLED=true
# IST; NSE publishes the delivery bhavcopy around 18:00, so 18:30 gets complete data
SCHEDULE_TIME=18:30
MAX_WORKERS=3
ANALYSIS_DELAY=0
BIAS_THRESHOLD=5.0
LOG_LEVEL=INFO
SAVE_CONTEXT_SNAPSHOT=true

# ---- API server ----------------------------------------------------------------------------------------------------------
API_AUTH_TOKEN=
